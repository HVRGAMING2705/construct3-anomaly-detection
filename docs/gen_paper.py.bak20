        ["", "BatchNorm1d(512) + ReLU + Dropout(0.1)", "512", "1,024"],
        ["", "Linear 512\u2192256", "256", "131,072 + 256 = 131,328"],
        ["", "BatchNorm1d(256) + ReLU + Dropout(0.1)", "256", "512"],
        ["", "Linear 256\u219232", "32", "8,192 + 32 = 8,224"],
        ["", "Encoder subtotal", "", "543,008"],
        ["Decoder", "Linear 32\u2192256", "256", "8,192 + 256 = 8,448"],
        ["", "BatchNorm1d(256) + ReLU + Dropout(0.1)", "256", "512"],
        ["", "Linear 256\u2192512", "512", "131,072 + 512 = 131,584"],
        ["", "BatchNorm1d(512) + ReLU + Dropout(0.1)", "512", "1,024"],
        ["", "Linear 512\u2192784 + Sigmoid", "784", "401,408 + 784 = 402,192"],
        ["", "Decoder subtotal", "", "543,760"],
        ["Total", "", "", "1,086,768"],
    ],
    "TABLE III", "FC-AE layer details. w = weights, b = biases.",
    widths=[0.65, 1.55, 0.65, 1.15], fontsize=7,
)
