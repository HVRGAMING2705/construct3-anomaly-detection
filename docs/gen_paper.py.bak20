    ("H. Zenati, C. S. Foo, B. Lecouat, G. Manek, and V. R. Chandrasekhar, \u201cEfficient GAN-based anomaly "
     "detection,\u201d in Proc. Int. Conf. Learn. Represent. (ICLR) Workshop, Vancouver, BC, Canada, 2018."),
    ("T. Chen, S. Kornblith, M. Norouzi, and G. Hinton, \u201cA simple framework for contrastive learning of "
     "visual representations,\u201d in Proc. 37th Int. Conf. Mach. Learn. (ICML), 2020, pp. 1597\u20131607."),
    ("K. He, H. Fan, Y. Wu, S. Xie, and R. Girshick, \u201cMomentum contrast for unsupervised visual "
     "representation learning,\u201d in Proc. IEEE Conf. Comput. Vis. Pattern Recognit. (CVPR), Seattle, WA, "
     "USA, 2020, pp. 9729\u20139738."),
    ("J. Davis and M. Goadrich, \u201cThe relationship between Precision-Recall and ROC curves,\u201d in "
     "Proc. 23rd Int. Conf. Mach. Learn. (ICML), Pittsburgh, PA, USA, 2006, pp. 233\u2013240."),
]
for i, ref in enumerate(refs, start=1):
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.LEFT
    p.paragraph_format.first_line_indent = Inches(-0.25)
    p.paragraph_format.left_indent = Inches(0.25)
    p.paragraph_format.space_after = Pt(2)
    p.paragraph_format.space_before = Pt(0)
    rr = p.add_run(f"[{i}]\t{ref}")
    run_fmt(rr, size=8)

# ------------------------------------------------------------------ save
os.makedirs(os.path.dirname(OUT), exist_ok=True)
doc.save(OUT)
print("saved:", OUT)

# ------------------------------------------------------------------ verify
from docx import Document as D2
d2 = D2(OUT)
n_para = len(d2.paragraphs)
n_tables = len(d2.tables)
n_pics = sum(1 for _ in d2.inline_shapes)
words = sum(len(p.text.split()) for p in d2.paragraphs)
words += sum(len(c.text.split()) for t in d2.tables for r in t.rows for c in r.cells)
size = os.path.getsize(OUT)
print(f"paragraphs={n_para} tables={n_tables} inline_images={n_pics} words~{words} size={size} bytes")
