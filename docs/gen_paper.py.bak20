        ["Pullover (2)", "1,090", "237", "1,000", "\u2014"],
        ["Dress (3)", "1,100", "240", "1,000", "\u2014"],
        ["Coat (4)", "1,105", "209", "1,000", "\u2014"],
        ["Sandal (5)", "\u2014", "\u2014", "\u2014", "1,000"],
        ["Shirt (6)", "1,160", "224", "1,000", "\u2014"],
        ["Sneaker (7)", "1,120", "196", "1,000", "\u2014"],
        ["Bag (8)", "1,120", "201", "1,000", "\u2014"],
