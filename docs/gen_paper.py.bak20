#!/usr/bin/env python3
"""Generate an IEEE-format .docx paper: Construct 3 autoencoders on Fashion-MNIST.
Original prose; all numbers below come from the project's fresh training runs.
"""
import os
from docx import Document
from docx.shared import Pt, Inches
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.enum.section import WD_SECTION
from docx.enum.table import WD_TABLE_ALIGNMENT
from docx.oxml.ns import qn
from docx.oxml import OxmlElement

OUT = "/home/hatch/workspace/construct3_remake/docs/Construct3_IEEE_Paper_NEW.docx"
FIGDIR = "/home/hatch/workspace/construct3_remake/figures"
FONT = "Times New Roman"

doc = Document()

# ---------------------------------------------------------------- page setup
sec = doc.sections[0]
sec.page_width = Inches(8.5)
sec.page_height = Inches(11)
sec.left_margin = Inches(0.75)
sec.right_margin = Inches(0.75)
sec.top_margin = Inches(0.75)
sec.bottom_margin = Inches(0.75)

# ---------------------------------------------------------------- base style
normal = doc.styles["Normal"]
normal.font.name = FONT
normal.font.size = Pt(10)
normal.element.rPr.rFonts.set(qn("w:eastAsia"), FONT)
pf = normal.paragraph_format
pf.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
pf.first_line_indent = Inches(0.18)
pf.space_after = Pt(4)
pf.space_before = Pt(0)
pf.line_spacing = 1.0
pf.widow_control = True


def set_cols(section, n, space_twips=360):
    sectPr = section._sectPr
    cols = sectPr.find(qn("w:cols"))
    if cols is None:
        cols = OxmlElement("w:cols")
        sectPr.append(cols)
    cols.set(qn("w:num"), str(n))
    cols.set(qn("w:space"), str(space_twips))


def run_fmt(run, size=10, bold=False, italic=False, small_caps=False, color=None):
    run.font.name = FONT
    run.font.size = Pt(size)
    run.font.bold = bold
    run.font.italic = italic
    run.font.small_caps = small_caps
    run.element.rPr.rFonts.set(qn("w:eastAsia"), FONT)
    if color is not None:
        run.font.color.rgb = color


def para(text, size=10, bold=False, italic=False, align=WD_ALIGN_PARAGRAPH.JUSTIFY,
         indent=True, space_after=4, space_before=0, small_caps=False):
    p = doc.add_paragraph()
    p.alignment = align
    p.paragraph_format.space_after = Pt(space_after)
    p.paragraph_format.space_before = Pt(space_before)
    if not indent:
        p.paragraph_format.first_line_indent = Inches(0)
    r = p.add_run(text)
    run_fmt(r, size=size, bold=bold, italic=italic, small_caps=small_caps)
    return p


def heading(number, title):
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p.paragraph_format.space_before = Pt(12)
    p.paragraph_format.space_after = Pt(6)
    p.paragraph_format.first_line_indent = Inches(0)
    label = f"{number}. {title}" if number else title
    r = p.add_run(label)
    run_fmt(r, size=10, bold=True, small_caps=True)
    return p


def subheading(label, title):
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.LEFT
    p.paragraph_format.space_before = Pt(8)
    p.paragraph_format.space_after = Pt(4)
    p.paragraph_format.first_line_indent = Inches(0)
    r = p.add_run(f"{label}. {title}")
    run_fmt(r, size=10, bold=False, italic=True)
    return p


def bullets(items):
    for it in items:
        p = doc.add_paragraph(style="List Bullet")
        p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
        p.paragraph_format.first_line_indent = Inches(0)
        p.paragraph_format.left_indent = Inches(0.3)
        p.paragraph_format.space_after = Pt(3)
        # clear default bullet run styling and set ours
        p.clear()
        r = p.add_run(it)
        run_fmt(r, size=10)


def fig_caption(num, text):
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p.paragraph_format.first_line_indent = Inches(0)
    p.paragraph_format.space_before = Pt(4)
    p.paragraph_format.space_after = Pt(10)
    r1 = p.add_run(f"Fig. {num}. ")
    run_fmt(r1, size=8, bold=False)
    r2 = p.add_run(text)
    run_fmt(r2, size=8)
    return p


def table_caption(label, text):
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p.paragraph_format.first_line_indent = Inches(0)
    p.paragraph_format.space_before = Pt(8)
    p.paragraph_format.space_after = Pt(4)
    r = p.add_run(f"{label}. {text}")
    run_fmt(r, size=8, bold=False, small_caps=True)
    return p


def add_table(headers, rows, caption_label, caption_text, widths=None, fontsize=8):
    table_caption(caption_label, caption_text)
    t = doc.add_table(rows=1 + len(rows), cols=len(headers))
    t.style = "Table Grid"
    t.alignment = WD_TABLE_ALIGNMENT.CENTER
    t.autofit = True
    for j, h in enumerate(headers):
        c = t.cell(0, j)
        c.paragraphs[0].alignment = WD_ALIGN_PARAGRAPH.CENTER
        r = c.paragraphs[0].add_run(h)
        run_fmt(r, size=fontsize, bold=True)
    for i, row in enumerate(rows, start=1):
        for j, val in enumerate(row):
            c = t.cell(i, j)
            c.paragraphs[0].alignment = WD_ALIGN_PARAGRAPH.CENTER
            c.vertical_alignment = 1  # center
            r = c.paragraphs[0].add_run(val)
            run_fmt(r, size=fontsize)
    if widths:
        for j, w in enumerate(widths):
            for i in range(1 + len(rows)):
                t.cell(i, j).width = Inches(w)
    doc.add_paragraph().paragraph_format.space_after = Pt(2)
    return t


FIG_COUNTER = [0]


def add_figure(fname, caption):
    """Centered figure spanning both columns (single-col continuous section)."""
    path = os.path.join(FIGDIR, fname)
    if not os.path.exists(path):
        print(f"WARNING: figure missing, skipped: {path}")
        return
    FIG_COUNTER[0] += 1
    n = FIG_COUNTER[0]
    s1 = doc.add_section(WD_SECTION.CONTINUOUS)
    set_cols(s1, 1)
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p.paragraph_format.first_line_indent = Inches(0)
    p.paragraph_format.space_before = Pt(8)
    p.paragraph_format.space_after = Pt(2)
    # scale: cap height at ~3.5 in by choosing width from aspect ratio
    import struct as _struct
    with open(path, "rb") as _fh:
        _d = _fh.read(33)
    _w, _h = _struct.unpack(">II", _d[16:24])
    _aspect = _w / _h
    _width_in = min(7.0, 3.5 * _aspect)
    run = p.add_run()
    run.add_picture(path, width=Inches(_width_in))
    fig_caption(n, caption)
    s2 = doc.add_section(WD_SECTION.CONTINUOUS)
    set_cols(s2, 2)


def add_figure_simple(fname, caption, width_in):
    """Figure inside the current (two-column) flow, column width."""
    path = os.path.join(FIGDIR, fname)
    if not os.path.exists(path):
        print(f"WARNING: figure missing, skipped: {path}")
        return
    FIG_COUNTER[0] += 1
    n = FIG_COUNTER[0]
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p.paragraph_format.first_line_indent = Inches(0)
    p.paragraph_format.space_before = Pt(6)
    p.paragraph_format.space_after = Pt(2)
    run = p.add_run()
    run.add_picture(path, width=Inches(width_in))
    fig_caption(n, caption)


# ================================================================ TITLE BLOCK
t = doc.add_paragraph()
t.alignment = WD_ALIGN_PARAGRAPH.CENTER
t.paragraph_format.space_after = Pt(12)
t.paragraph_format.first_line_indent = Inches(0)
r = t.add_run("Construct 3: Unsupervised Anomaly Detection and Denoising with Autoencoders on Fashion-MNIST")
run_fmt(r, size=24, bold=True)

for line in [
    "Hardageri Vikranth Reddy \u2014 Roll No. 24WU0102008",
    "Hasini Mukkumala \u2014 Roll No. 24WU0102042",
    "Affiliation: Department of Computer Science and Engineering",
]:
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p.paragraph_format.first_line_indent = Inches(0)
    p.paragraph_format.space_after = Pt(2)
    rr = p.add_run(line)
    run_fmt(rr, size=10)

# ------------------------------------------------------------------ abstract
doc.add_paragraph().paragraph_format.space_after = Pt(6)
pa = doc.add_paragraph()
pa.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
pa.paragraph_format.first_line_indent = Inches(0)
pa.paragraph_format.space_after = Pt(6)
ra = pa.add_run("Abstract\u2014")
run_fmt(ra, size=9, bold=True, italic=True)
rb = pa.add_run(
    "Autoencoders learn compact representations of data by training a network to reconstruct "
    "its own input through a narrow bottleneck, and the quality of that reconstruction doubles as "
    "a signal for both compression and anomaly detection. In this work we build, train, and compare "
    "three autoencoder variants\u2014a fully connected autoencoder, a convolutional autoencoder, and a "
    "denoising convolutional autoencoder\u2014on Fashion-MNIST, a dataset of 70,000 grayscale 28\u00d728 "
    "images of clothing items, compressing every image through a 32-dimensional latent code. We evaluate "
    "the models under a one-class anomaly detection protocol in which the Sandal class is withheld entirely "
    "from training and validation and must be flagged at test time from reconstruction error alone. We also "
    "test robustness by corrupting inputs with Gaussian noise of standard deviation 0.3 and asking the "
    "denoising model to recover the clean image. The convolutional autoencoder achieves the best overall "
    "performance with an ROC-AUC of 0.857 and the lowest reconstruction error (MSE 0.01459) while using "
    "roughly four times fewer parameters than the fully connected baseline. An ablation study shows that "
    "batch normalization is essential: removing it nearly doubles reconstruction error and sharply degrades "
    "detection performance."
)
run_fmt(rb, size=9, italic=True)

pi = doc.add_paragraph()
pi.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
pi.paragraph_format.first_line_indent = Inches(0)
pi.paragraph_format.space_after = Pt(10)
ri = pi.add_run("Index Terms\u2014")
run_fmt(ri, size=9, bold=True, italic=True)
rj = pi.add_run(
    "autoencoder, anomaly detection, denoising, Fashion-MNIST, representation learning, one-class classification."
)
run_fmt(rj, size=9, italic=True)

# ------------------------------------------------- switch to two-column body
body_sec = doc.add_section(WD_SECTION.CONTINUOUS)
set_cols(body_sec, 2)

# ================================================================ I. INTRO
heading("I", "Introduction")

para(
    "Modern production lines, from textile mills to electronics assembly, rely on visual inspection to catch "
    "defects before faulty goods reach customers. Human inspection is slow, expensive, and inconsistent, while "
    "supervised computer-vision systems demand large collections of labeled defect examples. The difficulty is "
    "that defects are, by definition, rare and unpredictable: a factory may run for months before a new failure "
    "mode appears, and nobody can enumerate every way a product might break. What is abundant instead is "
    "examples of normal, acceptable products. This asymmetry motivates unsupervised anomaly detection: learn a "
    "model of normality from defect-free data alone, then flag anything the model cannot explain as a candidate "
    "defect. Such a system needs no defect labels, adapts to whatever the normal class looks like, and degrades "
    "gracefully when novel failure modes appear."
)
para(
    "Autoencoders are a natural fit for this setting. An autoencoder is a neural network trained to reproduce its "
    "own input after passing it through a low-dimensional bottleneck, called the latent code. Because the "
    "bottleneck is too narrow to memorize the training set, the network is forced to discover the regularities "
    "of the data\u2014edges, textures, shapes, and their typical arrangements. Once trained on normal examples, the "
    "model reconstructs new normal inputs well but struggles with inputs that break those regularities, so the "
    "reconstruction error becomes a ready-made anomaly score: large error means the input does not look like "
    "anything the model has seen. This idea, introduced in the early deep learning literature [1] and extended "
    "with denoising objectives [2], [3], has since been applied to network intrusion, medical imaging, and "
    "industrial inspection [9], [10], [17]."
)
para(
    "Studying anomaly detection directly on factory imagery is attractive but impractical for a controlled "
    "comparison: real defect datasets are proprietary, small, and inconsistently labeled. Fashion-MNIST [5] "
    "offers a public, well-understood alternative. It contains 70,000 grayscale images of size 28\u00d728 pixels, "
    "evenly divided among ten clothing categories, with far more texture and silhouette variation than the "
    "handwritten digits of MNIST. Its difficulty sits in a useful middle ground: easy enough that a modest "
    "network can learn it on a CPU in minutes, yet hard enough that architectural choices visibly matter. "
    "Crucially, its class structure supports a clean one-class protocol. We designate one category\u2014Sandal, "
    "class index 5\u2014as the anomaly and remove it completely from training and validation. Sandals are "
    "visually distinctive, with thin straps and open regions, yet they share footwear semantics with the "
    "Sneaker and Ankle boot classes that remain in the normal set, so the task is neither trivial nor "
    "impossible. Success on this protocol is evidence that the model has learned normality rather than "
    "memorized pixels."
)
para(
    "This paper, the third in our Construct series on representation learning, makes three contributions. "
    "First, we compare fully connected, convolutional, and denoising autoencoders head-to-head on identical "
    "data, training budgets, and evaluation code, isolating the effect of architecture from the effect of "
    "experimental setup. Second, we define and execute a fixed one-class anomaly detection protocol with a "
    "held-out class and a principled threshold rule, reporting both threshold-dependent metrics "
    "(precision, recall, F1) and threshold-free ones (ROC-AUC, PR-AUC). Third, we ablate the two "
    "regularization components of our baseline\u2014batch normalization and dropout\u2014and quantify exactly "
    "how much each contributes to reconstruction quality and detection performance. All experiments run on a "
    "two-core CPU in about ten minutes total, demonstrating that meaningful representation-learning research "
    "remains accessible without specialized hardware."
)
para(
    "The remainder of this paper is organized as follows. Section II develops the mathematical preliminaries "
    "of autoencoders, the denoising objective, and the anomaly scoring rule. Section III surveys related work on "
    "autoencoders, convolutional variants, and anomaly detection. Section IV describes our dataset protocol, "
    "architectures, scoring rule, and latent-space analysis. Section V details the experimental setup. "
    "Section VI presents results and Section VII the ablation study. Section VIII deepens the latent-space and "
    "qualitative analysis, Section IX discusses deployment for visual quality control, and Section X surveys "
    "related application domains. Section XI examines the limitations and threats to validity of our study. "
    "Section XII concludes with directions for future work."
)

# ================================================================ II. MATH PRELIMINARIES
heading("II", "Mathematical Preliminaries")

para(
    "We formalize the autoencoder before describing our concrete instances, since the notation and objectives "
    "recur throughout the paper. Let \U0001d4b3 = [0,1]^N be the space of N-pixel grayscale images; here "
    "N = 28\u00d728 = 784. An autoencoder is a pair of neural networks: an encoder f\u03b8 : \U0001d4b3 "
    "\u2192 \u211d^d mapping an image x to a d-dimensional latent code z = f\u03b8(x), and a decoder "
    "g\u03c6 : \u211d^d \u2192 \U0001d4b3 mapping the code back to a reconstruction "
    "x\u0302 = g\u03c6(z). The vectors \u03b8 and \u03c6 collect the trainable weights of the two networks, "
    "and d is the bottleneck width. Choosing d \u226a N forces the model to compress: the code cannot "
    "memorize the input, so the network must discover its regularities."
)
pe = doc.add_paragraph()
pe.alignment = WD_ALIGN_PARAGRAPH.CENTER
pe.paragraph_format.first_line_indent = Inches(0)
pe.paragraph_format.space_before = Pt(4)
pe.paragraph_format.space_after = Pt(4)
re_ = pe.add_run("z = f\u03b8(x),\u2003\u2003x\u0302 = g\u03c6(z) = g\u03c6(f\u03b8(x)).")
run_fmt(re_, size=10, italic=True)
para(
    "Training minimizes the expected reconstruction error. Given M training images x\u2081,\u2026,x\u2098, the "
    "empirical objective is the mean squared error (MSE) between each input and its reconstruction:"
)
pe = doc.add_paragraph()
pe.alignment = WD_ALIGN_PARAGRAPH.CENTER
pe.paragraph_format.first_line_indent = Inches(0)
pe.paragraph_format.space_before = Pt(4)
pe.paragraph_format.space_after = Pt(4)
re_ = pe.add_run("\u2112(\u03b8, \u03c6) = (1/M) \u03a3\u1d62 \u2016x\u1d62 \u2212 g\u03c6(f\u03b8(x\u1d62))\u2016\u00b2.")
run_fmt(re_, size=10, italic=True)
para(
    "Minimizing \u2112 encourages the pair (f\u03b8, g\u03c6) to preserve as much of x as a d-dimensional code "
    "allows. In the special case of linear encoder and decoder this objective recovers principal component "
    "analysis; with nonlinear networks it learns richer data manifolds [1], [22]. The reconstruction of an "
    "input the model has never seen is therefore good exactly when that input lies near the learned manifold "
    "of normal data\u2014the property our anomaly detector exploits."
)
para(
    "The denoising autoencoder [2] modifies the objective rather than the architecture. Each training input is "
    "first corrupted, x\u0303 = clip(x + \u03b5) with \u03b5 \u223c \U0001d4a9(0, \u03c3\u00b2I), and the network "
    "must recover the clean target:"
)
pe = doc.add_paragraph()
pe.alignment = WD_ALIGN_PARAGRAPH.CENTER
pe.paragraph_format.first_line_indent = Inches(0)
pe.paragraph_format.space_before = Pt(4)
pe.paragraph_format.space_after = Pt(4)
re_ = pe.add_run("\u2112\u1d48\u2091\u2099(\u03b8, \u03c6) = E\u2093,\u1d61 [ \u2016x \u2212 g\u03c6(f\u03b8(x\u0303))\u2016\u00b2 ].")
run_fmt(re_, size=10, italic=True)
para(
    "Because the corruption destroys fine detail that could otherwise be copied straight through the "
    "bottleneck, the model must learn the statistical regularities of clean images in order to inpaint the "
    "damage. Those regularities are precisely what defines normality in our protocol, which is why the "
    "denoising objective doubles as a regularizer for anomaly detection."
)
para(
    "It is worth stating the geometric intuition that justifies using reconstruction error as an anomaly "
    "score, because the rest of the paper leans on it. The manifold hypothesis holds that high-dimensional "
    "real data concentrate near a low-dimensional manifold\u2014the set of all plausible garment images is a "
    "tiny fraction of the 784-dimensional cube. A well-trained autoencoder approximates the projection of "
    "an input onto this manifold: the encoder maps x to the nearest latent code, and the decoder maps the "
    "code back to the manifold itself, so x\u0302 is the manifold point closest to x and \u2016x \u2212 "
    "x\u0302\u2016 measures the distance from the input to normality. Normal inputs lie near the manifold "
    "and reconstruct with small error; anomalies lie far from it and reconstruct poorly. This view also "
    "explains the failure modes analyzed in Section VI: a low-contrast sandal lies accidentally close to the "
    "footwear region of the manifold and scores low, while a high-contrast sneaker with unusual texture lies "
    "far from its class region and scores high. The score is honest geometry, not a learned classifier "
    "decision, which is why its mistakes are interpretable."
)
para(
    "For scoring we use the per-image reconstruction error, normalized by the pixel count:"
)
pe = doc.add_paragraph()
pe.alignment = WD_ALIGN_PARAGRAPH.CENTER
pe.paragraph_format.first_line_indent = Inches(0)
pe.paragraph_format.space_before = Pt(4)
pe.paragraph_format.space_after = Pt(4)
re_ = pe.add_run("s(x) = \u2016x \u2212 x\u0302\u2016\u00b2 / N,")
run_fmt(re_, size=10, italic=True)
para(
    "with N = 784. Let F be the empirical distribution of s on normal validation images and let "
    "\u03c4 = Q\u2080.\u2089\u2085(F) be its 95th percentile. A test image is flagged anomalous when s(x) > "
    "\u03c4. This rule fixes the expected false-positive rate at 5% using only normal data, which is the "
    "operationally honest choice: defect samples are unavailable at the moment a factory threshold must be "
    "set. Given test labels we report precision P = TP/(TP+FP), recall R = TP/(TP+FN), and "
    "F1 = 2PR/(P+R) at this threshold, with Sandal images as positives. Because these three metrics all depend "
    "on the arbitrary choice of \u03c4, we also report threshold-free ranking metrics: ROC-AUC, the "
    "probability that a random anomaly outscores a random normal image, and PR-AUC, the area under the "
    "precision\u2013recall curve. With 10% anomaly prevalence, PR-AUC should be judged against a random "
    "baseline of 0.10, not 0.50. Table I collects the notation used throughout the paper."
)
add_table(
    ["Symbol", "Meaning"],
    [
        ["x", "Input image, x \u2208 [0,1]^784"],
        ["x\u0303", "Corrupted input (denoising training only)"],
        ["x\u0302", "Reconstruction, x\u0302 = g\u03c6(f\u03b8(x))"],
        ["z", "Latent code, z \u2208 \u211d^32"],
        ["s(x)", "Anomaly score: mean squared reconstruction error"],
        ["\u03c4", "Decision threshold: 95th percentile of normal validation errors"],
        ["N", "Pixels per image (784)"],
        ["M", "Training images (10,000)"],
        ["\u03c3", "Denoising noise standard deviation (0.3)"],
        ["d", "Latent dimension (32)"],
        ["\u03b8, \u03c6", "Encoder / decoder parameters"],
    ],
    "TABLE I", "Notation used in this paper.",
    widths=[0.9, 2.1], fontsize=8,
)

# ================================================================ III. RELATED
heading("II", "Related Work")

para(
    "The autoencoder in its modern form traces back to Hinton and Salakhutdinov [1], who showed that deep "
    "networks could be pretrained layer by layer to compress high-dimensional data into compact codes that "
    "reconstruct the input faithfully. Vincent et al. [2] strengthened the idea with the denoising autoencoder: "
    "corrupt the input with noise, then train the network to recover the clean original. Because the network "
    "can no longer rely on copying pixels through the bottleneck, it must capture the statistical structure of "
    "the data, yielding features that transfer better to downstream tasks. Stacking such layers [3] produced "
    "some of the first competitive deep representations before end-to-end supervised training became dominant. "
    "Kingma and Welling [4] later recast the autoencoder probabilistically as the variational autoencoder, "
    "imposing a prior on the latent space so that new samples can be generated by decoding random codes."
)
para(
    "Convolutional structure brought autoencoders firmly into image modeling. Masci et al. [16] introduced "
    "stacked convolutional autoencoders, replacing dense layers with shared convolutional filters that respect "
    "the translation invariance of natural images and drastically cut parameter counts. This development rested "
    "on the broader success of convolutional networks for recognition, from LeCun et al. [11] through the "
    "ImageNet breakthrough of Krizhevsky et al. [19] to residual architectures [14]. For reconstruction tasks, "
    "convolutions are appealing for the same reasons: local patterns such as fabric texture, stitching, and "
    "edges recur across positions, so weight sharing is both efficient and well matched to the data."
)
para(
    "Using reconstruction error for anomaly detection followed quickly. Sakurada and Yairi [17] demonstrated "
    "that autoencoders with nonlinear dimensionality reduction outperform linear baselines at flagging "
    "anomalous spacecraft telemetry. Zhou and Paffenroth [10] made the approach robust to contaminated "
    "training data by splitting each input into a low-dimensional reconstruction plus a sparse outlier "
    "component. An and Cho [18] replaced the point reconstruction of a variational autoencoder with a "
    "reconstruction probability, scoring anomalies by how unlikely the input is under the learned generative "
    "model. Schlegl et al. [9] took a different route with AnoGAN, training a generative adversarial network on "
    "normal data and searching its latent space at test time for the code whose generation best matches the "
    "query image. Ruff et al. [8] simplified the pipeline with Deep SVDD, which trains a network to map normal "
    "data into a minimal hypersphere and scores anomalies by their distance from the sphere center. Our work "
    "stays with the classical reconstruction-error formulation because it is simple, fast, and directly "
    "comparable across architectures, but we adopt the rigorous one-class evaluation discipline these papers "
    "advocate: the anomaly class never appears during training."
)
para(
    "Finally, our training recipe draws on standard deep learning practice. Batch normalization [6] stabilizes "
    "optimization by normalizing layer inputs within each mini-batch, dropout [7] regularizes by randomly "
    "deactivating units during training, and the Adam optimizer [12] adapts per-parameter learning rates. We "
    "visualize latent structure with t-SNE [13] and compute detection metrics with scikit-learn [15]. The "
    "Fashion-MNIST benchmark itself was introduced by Xiao et al. [5] as a drop-in replacement for MNIST that "
    "better exercises modern models. Goodfellow et al. [20] provide the broader theoretical background for the "
    "methods used here."
)
para(
    "Beyond the denoising criterion, several other regularizers have been proposed for autoencoders. Baldi [21] "
    "unified a wide family of autoencoder objectives, showing how weight tying, sparsity, and contractive "
    "penalties each shape the learned code, while Bengio, Courville, and Vincent [22] reviewed the "
    "representation-learning landscape and argued that unsupervised objectives are most valuable precisely when "
    "they force the model to disentangle the underlying factors of variation. Doersch [23] later provided the "
    "standard tutorial treatment of variational autoencoders, clarifying when the probabilistic machinery of "
    "[4] is worth its extra complexity over a deterministic bottleneck. On the generative side, Makhzani et al. "
    "[24] replaced the KL-divergence regularizer with an adversarial discriminator, matching the latent "
    "distribution to any desired prior, and Tschannen, Bachem, and Lucic [25] surveyed this crowded design "
    "space, concluding that much of the reported advantage of elaborate variants over plain autoencoders "
    "shrinks once training budgets and tuning effort are held equal\u2014a cautionary finding that motivates our "
    "own tightly controlled, fixed-budget comparison."
)
para(
    "The reconstruction-error idea has also been generalized for anomaly detection itself. Zong et al. [26] "
    "combined an autoencoder with a Gaussian mixture density estimator over the latent space, scoring anomalies "
    "by sample energy rather than pixel error, and reported consistent gains on several benchmarks. Such "
    "extensions are stronger than our baseline in absolute terms, but they add machinery\u2014density estimators, "
    "adversarial discriminators, mixture models\u2014whose tuning can obscure the architectural signal we want to "
    "isolate. Because our goal is a clean comparison of fully connected, convolutional, and denoising backbones "
    "rather than a leaderboard entry, we deliberately stay with the plainest scoring rule in the literature and "
    "leave these richer variants to future work, noting that any of them could be layered on top of our trained "
    "encoders."
)
para(
    "The question of which regularizer makes an autoencoder useful has a literature of its own, and it "
    "contextualizes our ablation results. Rifai et al. [28] introduced contractive autoencoders, which "
    "penalize the Frobenius norm of the encoder Jacobian so that the code becomes locally invariant to input "
    "perturbations\u2014a close analytical cousin of the denoising criterion that achieves robustness without "
    "sampling corruptions. Coates, Ng, and Lee [29] showed that sparse single-layer models, with proper "
    "whitening and preprocessing, are surprisingly competitive feature learners, a reminder that the "
    "bottleneck constraint we study is one member of a larger family. Lee et al. [27] extended the "
    "convolutional idea to deep belief networks, and Erhan et al. [30] explained why unsupervised "
    "pre-training helps deep learning at all: it places parameters in a basin of attraction that supervised "
    "fine-tuning alone rarely finds. Our finding that batch normalization dominates the ablation is consistent "
    "with this view\u2014normalization shapes the optimization landscape, and in deep stacks that shaping "
    "matters more than the choice of regularizer."
)
para(
    "It is instructive to spell out why the contractive and denoising criteria are cousins, since our "
    "Denoising-AE results bear on both. The contractive penalty sums the squared partial derivatives of "
    "every code unit with respect to every input pixel\u2014the squared Frobenius norm of the encoder "
    "Jacobian\u2014so the learned mapping is flat in directions where the data do not vary and sensitive "
    "only along the data manifold. The denoising criterion achieves a similar flatness implicitly: to "
    "reconstruct x from a corrupted x\u0303, the encoder must discard exactly those input variations that "
    "the corruption introduces, which are, by construction, off-manifold noise. Both regularizers therefore "
    "push the model toward the same geometric ideal described in Section II, differing mainly in how the "
    "penalty is computed\u2014analytically in one case, by sampling in the other. Our finding that the "
    "denoising model pays a small uniform reconstruction penalty (Section VI) is the empirical price of "
    "that flatness, and it suggests the contractive variant would land in the same place: slightly worse "
    "MSE, slightly better robustness, with the difference too small to matter at this training budget."
)
para(
    "Two further strands bear on our evaluation choices. First, the metric itself: Wang et al. [31] "
    "introduced the structural similarity index (SSIM) precisely because MSE correlates poorly with perceived "
    "image quality, penalizing a one-pixel shift as harshly as a structural defect. Our reliance on MSE "
    "follows the anomaly-detection literature for comparability, but SSIM-based or perceptual scoring is an "
    "obvious upgrade we leave to future work. Second, the field has matured to the point of surveys: "
    "Chalapathy and Chawla [32] and Pang et al. [33] map the migration from shallow to deep anomaly "
    "detection across domains, while Ruff et al. [34] unify deep one-class methods under the principle of "
    "learning a compact description of normality\u2014the principle our Sections II and IV instantiate in "
    "its simplest form."
)
para(
    "Modern work has also moved decisively toward real industrial data. Bergmann et al. [35] released MVTec "
    "AD, a dataset of genuine manufacturing defects across fifteen categories, which has become the standard "
    "testbed the field was missing. On it, memory-bank methods such as PatchCore [36] currently lead by "
    "comparing test patches against a coreset of normal patch features, while GAN-based approaches\u2014"
    "GANomaly [37] and EGBAD [38]\u2014learn normality adversarially. These methods outperform plain "
    "reconstruction error in absolute terms, but they also inherit heavier tuning and compute budgets. Our "
    "contribution sits deliberately beneath them: a controlled, reproducible baseline that isolates what "
    "architecture and regularization contribute before the heavier machinery is switched on."
)
para(
    "The probabilistic and adversarial extensions of the autoencoder deserve a closer technical look, since "
    "they define the frontier our baseline is measured against. The variational autoencoder [4], [23] "
    "replaces the deterministic code z with a posterior distribution q\u03b8(z|x) and trains by maximizing "
    "the evidence lower bound, balancing reconstruction fidelity against a KL-divergence penalty that pulls "
    "the posterior toward a prior, typically \U0001d4a9(0, I). An and Cho [18] turned this machinery into an "
    "anomaly detector by scoring inputs with reconstruction probability\u2014how likely the input is under "
    "the learned generative model\u2014rather than raw pixel error, which in principle calibrates the "
    "score better on ambiguous inputs. The GAN-based family [9], [37], [38] goes further: a generator learns "
    "the normal manifold adversarially, and at test time the query image is projected onto that manifold by "
    "optimizing over latent codes (Schlegl et al. [9]) or by a jointly trained encoder (Akcay et al. [37]; "
    "Zenati et al. [38]), with the residual between query and projection serving as the anomaly score. These "
    "methods are powerful but pay for it in training instability and test-time optimization cost\u2014"
    "precisely the complexity our fixed-budget comparison is designed to avoid."
)
para(
    "A parallel thread worth acknowledging is self-supervised contrastive learning, which has largely "
    "supplanted autoencoders as the default unsupervised pre-training paradigm in vision. SimCLR [39] learns "
    "representations by pulling together augmented views of the same image while pushing apart different "
    "images, and MoCo [40] made the approach memory-efficient with a momentum encoder and a queue of "
    "negatives. These methods produce excellent linear-probe features, but they optimize for discrimination "
    "between instances rather than reconstruction of inputs, so they do not directly yield an anomaly score: "
    "there is no x\u0302 to compare against x. Hybrid approaches that combine contrastive pre-training with "
    "a reconstruction head are an active research direction, and our per-class analysis in Section VI suggests "
    "a concrete way they could help\u2014by tightening the normal manifold for hard classes like Bag, where "
    "pure reconstruction currently struggles."
)

# ================================================================ IV. METHOD
heading("IV", "Methodology")

subheading("A", "Dataset and One-Class Protocol")
para(
    "Fashion-MNIST [5] comprises 70,000 grayscale images of 28\u00d728 pixels, split by its curators into "
    "60,000 training and 10,000 test images across ten balanced classes: T-shirt/top, Trouser, Pullover, Dress, "
    "Coat, Sandal, Shirt, Sneaker, Bag, and Ankle boot. Pixel intensities are scaled to the [0, 1] interval. "
    "For our one-class protocol, class index 5 (Sandal) is designated the anomaly class and every Sandal image "
    "is removed from the training and validation pools before any learning begins. From the remaining nine "
    "classes we sample 10,000 images for training and 2,000 for validation. The test set combines 9,000 "
    "normal images (1,000 per remaining class) with 1,000 held-out Sandal images. Test labels are used only to "
    "compute evaluation metrics; the models never see them during training or threshold selection."
)
para(
    "Fixing a single held-out class, rather than cycling through all ten, keeps the comparison focused: every "
    "architecture faces exactly the same normal distribution and exactly the same anomaly distribution, so "
    "performance differences reflect modeling choices rather than task variation. Sandal is a deliberate choice "
    "of moderate difficulty. Its open, strappy structure differs from every normal class, yet as footwear it "
    "lies closer to Sneaker and Ankle boot than, say, a Bag would lie to a T-shirt, so a model that merely "
    "memorizes silhouettes without understanding texture will still be challenged."
)

subheading("B", "Architectures")
para(
    "All three models compress each 784-pixel image into a 32-dimensional latent vector and reconstruct it with "
    "a sigmoid output layer matched to the [0, 1] pixel range. The fully connected autoencoder (FC-AE) uses a "
    "symmetric dense stack: 784\u2192512\u2192256\u219232\u2192256\u2192512\u2192784. Every hidden linear layer is followed by "
    "batch normalization, a ReLU activation, and dropout with rate 0.1. The network contains 1,086,768 "
    "trainable parameters. The convolutional autoencoder (Conv-AE) replaces dense layers with a convolutional "
    "encoder: two blocks of 3\u00d73 convolution with stride 2 and padding 1 (1\u219232 then 32\u219264 channels), each "
    "followed by batch normalization and ReLU, reducing the 28\u00d728 input to 64 feature maps of 7\u00d77. These "
    "are flattened to 3,136 units and projected to the 32-dimensional code. The decoder mirrors this path: a "
    "linear layer back to 3,136 units, reshaping, then two transposed convolutions (64\u219232 and 32\u21921, kernel "
    "4, stride 2, padding 1) with batch normalization and ReLU between them and a final sigmoid. It uses only "
    "256,257 parameters\u2014roughly one quarter of the dense model\u2014thanks to weight sharing. The denoising "
    "autoencoder (Denoising-AE) shares the Conv-AE backbone exactly, but its inputs are corrupted before encoding: "
    "we add zero-mean Gaussian noise with standard deviation 0.3 to each training image and clip the result to "
    "[0, 1], while the loss is computed against the clean original. This forces the network to separate signal "
    "from noise rather than merely copying pixels."
)

subheading("C", "Anomaly Scoring")
para(
    "For a test image x with reconstruction x\u0302, the anomaly score is the per-image mean squared error:"
)
pe = doc.add_paragraph()
pe.alignment = WD_ALIGN_PARAGRAPH.CENTER
pe.paragraph_format.first_line_indent = Inches(0)
pe.paragraph_format.space_before = Pt(4)
pe.paragraph_format.space_after = Pt(4)
re_ = pe.add_run("s(x)  =  ||x \u2212 x\u0302||\u00b2 / N,")
run_fmt(re_, size=10, italic=True)
para(
    "where N = 784 is the number of pixels. The decision threshold \u03c4 is set to the 95th percentile of the "
    "reconstruction errors observed on normal validation images, a common operating-point choice that fixes the "
    "expected false-positive rate at 5% on normal data without ever looking at anomalies. A test image is "
    "flagged anomalous when s(x) > \u03c4. At this threshold we report precision, recall, and F1 against the "
    "Sandal labels. Because any single threshold is somewhat arbitrary, we also report threshold-free metrics: "
    "the area under the ROC curve (ROC-AUC), which measures ranking quality over all thresholds, and the area "
    "under the precision\u2013recall curve (PR-AUC), which is more informative when anomalies are rare. With a "
    "10% anomaly prevalence in our test set, PR-AUC values should be read against a random baseline of 0.10 "
    "rather than 0.50."
)
para(
    "Reporting both curves is not redundancy but necessity under class imbalance. Davis and Goadrich [41] "
    "showed that while ROC and PR curves contain the same ranking information, the PR curve magnifies "
    "differences in the high-precision region that matters when positives are rare: a model can have a "
    "respectable ROC-AUC yet a poor PR-AUC if its few top-ranked predictions are wrong. Our results exhibit "
    "exactly this pattern\u2014ROC-AUC near 0.85 but PR-AUC near 0.37\u2014so the pair together tells the "
    "honest story: the models rank anomalies well overall, but the very top of the ranked list is not pure. "
    "Any deployment decision must therefore consult the PR curve (Fig. 6), not the ROC curve alone."
)
para(
    "A final word on experimental design: the three models were chosen so that each pairwise comparison "
    "isolates exactly one factor. FC-AE versus Conv-AE varies the architecture while holding the objective "
    "fixed, measuring the value of convolutional inductive bias. Conv-AE versus Denoising-AE varies the "
    "objective while holding the architecture fixed, measuring the value of the denoising criterion. No "
    "comparison varies both at once, so every performance gap in Section VI has an unambiguous attribution. "
    "The ablation pair in Section VII then decomposes the winning FC baseline further, isolating the "
    "contributions of its two regularizers. This factorial discipline is what elevates the study from a "
    "bake-off to an experiment: we do not merely report which model wins, but why."
)

subheading("D", "Latent-Space Analysis")
para(
    "To check whether the 32-dimensional codes capture semantically meaningful structure, we project the test "
    "embeddings of the Conv-AE with principal component analysis and with t-SNE (perplexity 30) [13] and color "
    "each point by its true class. A well-trained encoder should place visually similar garments near one "
    "another and separate the held-out Sandal class from the normal manifold even though it never saw Sandals "
    "during training. These visualizations are qualitative diagnostics only; no class labels influence the "
    "models themselves."
)

subheading("E", "Reproducibility Discipline")
para(
    "Three rules govern every experiment reported here. First, the test set is never consulted during model "
    "selection: the anomaly threshold \u03c4 is computed from validation errors only, and no architecture or "
    "hyperparameter was chosen using test metrics. Second, randomness is fully controlled\u2014seed 42 governs "
    "weight initialization, data shuffling, subset sampling, and noise generation\u2014so every number is "
    "exactly reproducible under the software stack of Table VII. Third, the three baselines share one "
    "training recipe (Table VI); the only deliberate variation across runs is the shorter epoch budget of "
    "the ablation variants. These rules are what make the architectural comparison in Section VI a fair one."
)

# ================================================================ V. SETUP
heading("V", "Experimental Setup")

subheading("A", "Training Recipe")
para(
    "All models are implemented in PyTorch and trained on CPU. Optimization uses Adam [12] with learning rate "
    "10\u207b\u00b3 and weight decay 10\u207b\u2074, under a cosine annealing schedule that decays the learning rate "
    "smoothly to zero. The loss is mean squared error between reconstruction and target (clean target for the "
    "denoising model), minimized in mini-batches of 256. Baselines train for 8 epochs; ablation variants train "
    "for 4 epochs, which pilot runs showed is sufficient to reveal the effect being isolated. Every run uses "
    "random seed 42 for weight initialization, data shuffling, and noise sampling, so results are exactly "
    "reproducible. Total training time for all reported runs is approximately ten minutes on a two-core CPU. "
    "Detection metrics and the t-SNE projection are computed with scikit-learn [15]."
)
para(
    "Table VI records the complete training configuration so that every number in this paper can be reproduced "
    "exactly. The recipe is deliberately ordinary: standard Adam, a cosine schedule, and no learning-rate "
    "warmup or gradient clipping, because we wanted the architectural comparison\u2014not optimizer tuning\u2014to "
    "drive the results. All three baselines share one configuration; the only intentional difference across "
    "runs is the shorter epoch budget of the ablation variants. The denoising noise level \u03c3=0.3 was fixed "
    "before any evaluation runs and was not tuned against the test metrics."
)
add_table(
    ["Hyperparameter", "Value"],
    [
        ["Optimizer", "Adam (\u03b2\u2081=0.9, \u03b2\u2082=0.999)"],
        ["Initial learning rate", "10\u207b\u00b3"],
        ["LR schedule", "Cosine annealing to 0"],
        ["Weight decay", "10\u207b\u2074"],
        ["Batch size", "256"],
        ["Epochs (baselines)", "8"],
        ["Epochs (ablations)", "4"],
        ["Loss", "Mean squared error"],
        ["Denoising noise", "Gaussian, \u03c3 = 0.3 (train only)"],
        ["Latent dimension", "32"],
        ["Dropout rate", "0.1 (FC-AE hidden layers)"],
        ["Random seed", "42 (init, shuffle, noise)"],
        ["Hardware", "Two-core CPU"],
        ["Total training time", "\u2248 10 minutes (all runs)"],
    ],
    "TABLE VI", "Training configuration shared across all runs.",
    widths=[1.45, 1.55], fontsize=8,
)

subheading("B", "Model Implementation Details")
para(
    "Tables III and IV give the exact layer-by-layer structure of the two backbones, with parameter counts "
    "broken into weights and biases. The FC-AE is a symmetric dense stack: every hidden linear layer is "
    "followed by batch normalization, ReLU, and dropout at rate 0.1, while the bottleneck projection and the "
    "final output layer are plain linear maps. The encoder holds 543,008 parameters and the decoder 543,760, "
    "for a total of 1,086,768. The Conv-AE encoder applies two strided convolutions that reduce 28\u00d728 to "
    "64 feature maps of 7\u00d77, flattens to 3,136 units, and projects to the 32-dimensional code; the decoder "
    "mirrors this with a linear expansion and two transposed convolutions. The two linear layers around the "
    "bottleneck dominate its budget (100,384 + 103,488 parameters), while the four convolutional layers "
    "together contribute only about 52,000\u2014the essence of weight sharing. The Denoising-AE reuses the "
    "Conv-AE backbone exactly and adds zero parameters; its only difference is the input corruption "
    "x\u0303 = clip(x + \u03b5), \u03b5 \u223c \U0001d4a9(0, 0.09), applied during training."
)
add_table(
